# Secrets - never commit your API key
.env
.streamlit/secrets.toml

# Generated by running the notebook. Only the files the Streamlit app reads are committed,
# so the app can be hosted (e.g. Streamlit Community Cloud) without re-running the notebook.
outputs/*
!outputs/recalls.db
!outputs/snapshot_provenance.json
!outputs/project_evaluation.csv
!outputs/vector_db/
outputs/vector_db/*
!outputs/vector_db/documents.json
!outputs/vector_db/vectors.npy
!outputs/tableau/
outputs/tableau/*
!outputs/tableau/monthly_series.csv
!outputs/tableau/backtest.csv
!outputs/tableau/method_summary.csv

# Local Python / Jupyter files
.venv/
venv/
__pycache__/
.ipynb_checkpoints/
.idea/
.DS_Store
